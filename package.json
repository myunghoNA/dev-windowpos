  "scripts": {
    "--- VERSIONING ---": "================================================",
    "patch": "npm version patch",
    "minor": "npm version minor",
    "major": "npm version major",
    "--- BUILD & TYPES ---": "================================================",
    "buildEnvTypes": "node ./bin/buildEnvTypes.js",
    "prebuild": "npm run buildEnvTypes",
    "build": "node ./bin/build.js",
    "rebuild": "electron-rebuild -f -w",
    "rebuild:32": "electron-rebuild -f -w --arch=ia32",
    "--- DEVELOPMENT ---": "================================================",
    "prewatch": "node ./bin/resetDistSource.js && npm run rebuild:32 && npm run buildEnvTypes",
    "watch": "node ./bin/watch.js",
    "watch:debug": "npm run prewatch && cross-env DEBUG_MODE=true node ./bin/watch.js",
    "--- TESTING ---": "=======================================================",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "--- COMPILE & DEPLOY (DEV) ---": "=========================================",
    "precompile:dev": "cross-env MODE=dev npm run build",
    "compile:dev": "electron-builder build --config ./config/electron-builder-dev.js",
    "predeploy:dev": "cross-env MODE=dev npm run build",
    "deploy:dev": "electron-builder build --publish always --config ./config/electron-builder-dev.js",
    "--- COMPILE & DEPLOY (STAG) ---": "========================================",
    "precompile:stag": "cross-env MODE=stag npm run build",
    "compile:stag": "electron-builder build --config ./config/electron-builder-stag.js",
    "predeploy:stag": "cross-env MODE=stag npm run build",
    "deploy:stag": "electron-builder build --publish always --config ./config/electron-builder-stag.js",
    "--- COMPILE & DEPLOY (PROD) ---": "========================================",
    "precompile:prod": "cross-env MODE=prod npm run build",
    "compile:prod": "electron-builder build --config ./config/electron-builder-prod.js"
  },
  "browserslist": {
    "production": [
      "last 1 electron version",
      "not dead"
    ],
    "development": [
      "last 1 electron version"
    ]
  },
