{
  "parser": "@typescript-eslint/parser",
  "plugins": ["@typescript-eslint", "filename-rules"],
  "extends": [
    "eslint:recommended",
    "plugin:@typescript-eslint/recommended"
  ],
  "rules": {
    // 파일명은 무조건 kebab-case
    // "filename-rules/match": ["error", "kebab-case"],
    
    // any 타입 사용 경고
    "@typescript-eslint/no-explicit-any": "off",

    "no-useless-escape": "off",

    "@typescript-eslint/no-require-imports": "off",
    
    // 사용하지 않는 변수 경고 (underscore로 시작하면 제외)
    "@typescript-eslint/no-unused-vars": ["error", { "argsIgnorePattern": "^_" }],

    
    // 스타일 규칙 (Prettier 역할 대신)
    "semi": ["error", "always"],
    "quotes": ["error", "single"],
    "comma-dangle": ["error", "always-multiline"],
    "complexity": ["warn", 50]
  },
  "env": {
    "node": true,    // Node.js 전역 변수(require, __dirname 등) 허용
    "browser": true, // 브라우저 전역 변수 허용
    "es2021": true
  }
}