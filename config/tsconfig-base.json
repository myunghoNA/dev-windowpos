{
  "compilerOptions": {
    "module": "esnext",    /* 모듈을 위한 코드 생성 설정: 'none', 'commonjs', 'amd', 'system', 'umd', 'es2015', 'es2020', or 'ESNext'. */
    "target": "esnext",
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "sourceMap": true,
    "skipLibCheck": true,  /* 정의 파일의 타입 확인을 건너 뛸 지 여부 */
    "strict": true,
    "isolatedModules": true,
    "allowJs": false,
    "esModuleInterop": true, /* 다양한 패키지 간의 모듈 호환성 문제 해결 */
    "allowSyntheticDefaultImports": true,   /* default export이 아닌 모듈에서도 default import가 가능 */
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": false,
    "moduleResolution": "bundler",  /* 모듈 해석 방법 설정*/
    "resolveJsonModule": true,
    "noEmit": false,
    "jsx": "react",
    "emitDecoratorMetadata": false, /* decorator를 위한 타입 메타데이터를 내보내는 것에 대한 실험적 지원 여부 */
    "experimentalDecorators": false,
    "removeComments": false,
    "noImplicitAny": false, /* 암묵적 any 방지로 타입 안전성 강화*/
    "types": [
      "vite/client", // Vite 기본 타입은 공통으로 가져감
      "node"
    ]
  },
  "exclude": [
    "../**/node_modules"
  ]
}
